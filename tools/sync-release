#!/usr/bin/env python3
"""Release hook run by expanse's scripts/release.sh: sync the site to dist/<version>/ and commit.

Usage: tools/sync-release [--no-commit] DIR
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import release_sync  # noqa: E402

parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
parser.add_argument("release_dir", type=Path, help="dist/<version>/ holding release.json and notes.md")
parser.add_argument("--no-commit", action="store_true", help="edit the site files but do not commit")
args = parser.parse_args()
site = Path(__file__).resolve().parent.parent
try:
    changed = release_sync.sync(site, args.release_dir.resolve(), commit=not args.no_commit)
except (release_sync.SyncError, OSError, ValueError) as e:
    sys.exit(f"sync-release: {e}")
version = release_sync.site_version(site)
print(f"sync-release: site at {version}; " + (f"updated {', '.join(changed)}" if changed else "already up to date"))
for problem in release_sync.block_problems(site, args.release_dir, version):
    print(f"sync-release: warning: block pages: {problem}", file=sys.stderr)
